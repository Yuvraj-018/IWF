            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 2550,\n  \"receipt\": \"order_rcpt_101\",\n  \"notes\": {\n    \"purpose\": \"Blue Membership Fee\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/create-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "create-order"
              ]
            },
            "description": "Creates a real Razorpay order on Razorpay servers and returns order_id, amount, currency, and key_id."
          },
          "response": []
        },
        {
          "name": "Verify Payment - Membership Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpay_order_id\": \"order_test_123456789\",\n  \"razorpay_payment_id\": \"pay_test_987654321\",\n  \"razorpay_signature\": \"test_signature_hash\",\n  \"memberData\": {\n    \"fullName\": \"Mohammad Tariq\",\n    \"fatherName\": \"Abdul Rahman\",\n    \"category\": \"Blue\",\n    \"amount\": 2550,\n    \"membershipPeriod\": 1,\n    \"email\": \"tariq@example.com\",\n    \"mobile\": \"9876543210\",\n    \"countryCode\": \"+91\",\n    \"state\": \"Bihar\",\n    \"district\": \"Darbhanga\",\n    \"address\": \"Ward 4, Near Jama Masjid\",\n    \"pincode\": \"846004\",\n    \"consentDisplay\": \"yes\",\n    \"paymentMode\": \"Razorpay / Online\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/verify-payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify-payment"
              ]
            },
            "description": "Verifies HMAC SHA256 payment signature, activates the member in MongoDB, creates verification certificate, generates receipt number, and dispatches the welcome email."
          },
          "response": []
        },
        {
          "name": "Verify Payment - Membership Renewal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpay_order_id\": \"order_test_ren_123\",\n  \"razorpay_payment_id\": \"pay_test_ren_456\",\n  \"razorpay_signature\": \"test_signature_hash\",\n  \"memberData\": {\n    \"isRenewal\": true,\n    \"memberNo\": \"Islah-BL-2025-001\",\n    \"membershipPeriod\": 1,\n    \"amount\": 2550,\n    \"paymentMode\": \"Razorpay / Online\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/verify-payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify-payment"
              ]
            },
            "description": "Verifies payment for renewal, extends the member validity date by the selected years, and updates verification certificate."
          },
          "response": []
        },
        {
          "name": "Verify Payment - 80G Donation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpay_order_id\": \"order_test_don_123\",\n  \"razorpay_payment_id\": \"pay_test_don_456\",\n  \"razorpay_signature\": \"test_signature_hash\",\n  \"donationData\": {\n    \"donorName\": \"Dr. Zameer Ahmad\",\n    \"donorType\": \"Individual\",\n    \"email\": \"zameer@example.com\",\n    \"phone\": \"9812345678\",\n    \"countryCode\": \"+91\",\n    \"address\": \"Flat 402, Green Valley Apartments\",\n    \"city\": \"Patna\",\n    \"state\": \"Bihar\",\n    \"pincode\": \"800001\",\n    \"financialType\": \"Medical Emergency\",\n    \"amount\": 5000,\n    \"taxExemption\": true,\n    \"pan\": \"ABCDE1234F\",\n    \"patientSlug\": \"mohammed-salim\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/verify-payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify-payment"
              ]
            },
            "description": "Verifies donation payment, increments raised amount on patient, issues official 80G tax exemption receipt, and emails receipt to donor."
          },
          "response": []
        },
        {
          "name": "Razorpay Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-razorpay-signature",
                "value": "sample_webhook_signature"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_12345678\",\n        \"order_id\": \"order_12345678\",\n        \"amount\": 255000,\n        \"status\": \"captured\"\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhook/razorpay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhook",
                "razorpay"
              ]
            },
            "description": "Webhook listener for Razorpay asynchronous payment events (e.g. payment.captured, payment.failed)."
          },
          "response": []
        }
      ]
    },
