    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^9.0.3",
    "nodemon": "^3.1.14",
    "razorpay": "^2.9.8",
    "zod": "^4.6.6"
